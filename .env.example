# 必填：本服务能以任意已登录账号操作真实平台，没有凭据就不许起。至少 16 位。
GEO_BROWSER_API_KEY=

# 监听地址。默认只绑本机；改成对外地址时启动会告警，且必须自行加反代鉴权。
GEO_BROWSER_HOST=127.0.0.1
GEO_BROWSER_PORT=3310

# profile 与台账的落盘位置。里面是活的登录态，见 README「凭据与磁盘」。
GEO_BROWSER_DATA_DIR=.data

# 会话与画面
GEO_BROWSER_SESSION_TTL_MINUTES=15
GEO_BROWSER_VIEWPORT_WIDTH=1440
GEO_BROWSER_VIEWPORT_HEIGHT=900
GEO_BROWSER_SCREENCAST_QUALITY=60

# 限速（默认值来自 OneGl 实测保守档，不是平台官方上限）
GEO_BROWSER_ACTION_INTERVAL_MS=350
GEO_BROWSER_MIN_RUN_GAP_MS=45000
GEO_BROWSER_HOURLY_LIMIT=6
GEO_BROWSER_DAILY_LIMIT=20
GEO_BROWSER_FAILURE_THRESHOLD=3
GEO_BROWSER_COOLDOWN_MINUTES=60

# 单张配图字节上限：载荷以 base64 随作业传入，不设上限会被一张原图打穿内存。
GEO_BROWSER_IMAGE_MAX_BYTES=6291456
